<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ID Lab in the browser: the same sources as IDLab.Desktop, compiled to WebAssembly (.NET + raylib on WebGL 2).
    Needs the wasm-tools workload once:   dotnet workload install wasm-tools
    Build the site:                       dotnet publish IDLab.Web -c Release
    The site is bin/Release/net8.0/browser-wasm/AppBundle (any static web host; open index.html over http).
    native/raylib.a is raylib 5.5 compiled with the same Emscripten (3.1.34):
      emcc -c rcore.c rshapes.c rtextures.c rtext.c rmodels.c utils.c raudio.c -Os -DPLATFORM_WEB -DGRAPHICS_API_OPENGL_ES3
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <StartupObject>IDLab.Web.WebMain</StartupObject>
    <AssemblyName>IDLab</AssemblyName>
    <RootNamespace>IDLab.Web</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <WasmBuildNative>true</WasmBuildNative>
    <EmccExtraLDFlags>-sUSE_GLFW=3 -sMAX_WEBGL_VERSION=2 -sMIN_WEBGL_VERSION=2 -sFULL_ES3=1</EmccExtraLDFlags>
    <!-- Turkish text rules (İ/ı) need the full ICU data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <WasmIncludeFullIcuData>true</WasmIncludeFullIcuData>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../IDLab.Desktop/**/*.cs" Exclude="../IDLab.Desktop/bin/**;../IDLab.Desktop/obj/**" />
    <EmbeddedResource Include="../IDLab.Desktop/Assets/DejaVuSans.ttf" LogicalName="font.regular" />
    <EmbeddedResource Include="../IDLab.Desktop/Assets/DejaVuSans-Bold.ttf" LogicalName="font.bold" />
    <EmbeddedResource Include="../IDLab.Desktop/Assets/idlab-512.png" LogicalName="icon.png" />
    <EmbeddedResource Include="../IDLab.Desktop/Assets/ghs/ghs0*.png" LogicalName="%(Filename)%(Extension)" />
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <ProjectReference Include="../IDLab.Core/IDLab.Core.csproj" />
    <NativeFileReference Include="native/raylib.a" />
    <WasmExtraFilesToDeploy Include="wwwroot/index.html;wwwroot/logo.png;wwwroot/favicon.png" />
  </ItemGroup>
</Project>
