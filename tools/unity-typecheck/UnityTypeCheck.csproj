<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CI / headless sanity check for the Unity presentation layer.

    Compiles app/Assets/IDLab/Scripts together with the core sources against Unity *reference*
    assemblies from NuGet (UnityEngine.Modules 2021.3 + uGUI 2020.3), so API typos and type errors are
    caught without a Unity install or licence. It does not replace opening the project in Unity
    (the real target is Unity 6), it only proves the scripts type-check against the Unity API surface.

      dotnet build tools/unity-typecheck
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);ENABLE_LEGACY_INPUT_MANAGER;UNITY_TYPECHECK</DefineConstants>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../core/com.idlab.core/Runtime/**/*.cs" />
    <Compile Include="../../app/Assets/IDLab/Scripts/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Unity3D.UnityEngine.UI" Version="2020.3.21" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Unity3D.UnityEngine" Version="2020.3.21" ExcludeAssets="all" />
  </ItemGroup>
  <Target Name="AddUnityReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Include="$(PkgUnityEngine_Modules)/lib/net35/*.dll" Private="false" />
      <Reference Include="$(PkgUnity3D_UnityEngine_UI)/lib/UnityEngine.UI.dll" Private="false" />
    </ItemGroup>
  </Target>
</Project>
