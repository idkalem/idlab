<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the engine-agnostic simulation core outside Unity so it can be unit tested
    with `dotnet test`. Unity compiles the very same sources through
    com.idlab.core/Runtime/IDLab.Core.asmdef.

    Target + language level are pinned to what Unity 2022.3 / Unity 6 support
    (netstandard2.1, C# 9) so nothing compiles here that would fail inside Unity.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>IDLab.Core</RootNamespace>
    <AssemblyName>IDLab.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="com.idlab.core/Runtime/**/*.cs" />
  </ItemGroup>
</Project>
