<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ID Lab desktop / smart-board edition: a native, Unity-free front-end over the same simulation core.
    Publish a single double-clickable Windows .exe (runtime, raylib and fonts embedded):
      dotnet publish desktop/IDLab.Desktop -c Release -r win-x64
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>IDLab</AssemblyName>
    <RootNamespace>IDLab.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/idlab.ico</ApplicationIcon>
    <Product>ID Lab</Product>
    <AssemblyTitle>ID Lab — 3D Fen Laboratuvarı</AssemblyTitle>
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Single-file, self-contained publish: nothing to install on the board. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trim unused framework code: keeps the .exe small enough to copy/share easily. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <ProjectReference Include="../../core/IDLab.Core.csproj" />
    <EmbeddedResource Include="Assets/DejaVuSans.ttf" LogicalName="font.regular" />
    <EmbeddedResource Include="Assets/DejaVuSans-Bold.ttf" LogicalName="font.bold" />
    <EmbeddedResource Include="Assets/idlab-512.png" LogicalName="icon.png" />
    <EmbeddedResource Include="Assets/ghs/ghs0*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
